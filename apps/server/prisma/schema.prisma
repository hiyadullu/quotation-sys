generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum ProductCategory {
  EQUIPMENT
  PLUMBING
  CIVIL
  SERVICES
}

enum DiscountType {
  AMOUNT
  PERCENT
}

enum TemplateKind {
  SCOPE
  PAYMENT
  TERMS
}

enum ActivityType {
  CREATED
  UPDATED
  PDF_GENERATED
  SENT_EMAIL
  SENT_WHATSAPP
  STATUS_CHANGED
  REVISED
  DUPLICATED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  mobile       String?  @unique
  passwordHash String
  role         Role     @default(SALES)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customers  Customer[]
  quotes     Quote[]
  activities QuoteActivity[]
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  mobile      String
  email       String?
  address     String?
  siteAddress String?
  city        String?
  gstin       String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User    @relation(fields: [createdById], references: [id])
  quotes    Quote[]

  @@index([name])
  @@index([mobile])
}

/// Binary uploads (logo, signature, product photos). Stored in Postgres so a single
/// database backup captures everything and the app stays stateless on cloud hosts.
model Asset {
  id        String   @id @default(cuid())
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  products Product[]
}

model Product {
  id          String          @id @default(cuid())
  name        String
  description String?
  category    ProductCategory
  brand       String?
  model       String?
  unit        String          @default("Nos")
  price       Decimal         @db.Decimal(12, 2)
  gstPercent  Decimal         @default(18) @db.Decimal(5, 2)
  imageId     String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  image Asset?       @relation(fields: [imageId], references: [id], onDelete: SetNull)
  items QuoteItem[]

  @@index([category, isActive])
  @@index([name])
}

/// Single-row table (id is always 1) holding company, financial and quotation defaults.
model Settings {
  id                Int      @id @default(1)
  companyName       String
  tagline           String?
  address           String
  city              String?
  state             String?
  pincode           String?
  gstin             String?
  mobile            String
  email             String
  website           String?
  defaultGstPercent Decimal  @default(18) @db.Decimal(5, 2)
  bankName          String?
  accountName       String?
  accountNumber     String?
  ifsc              String?
  bankBranch        String?
  upiId             String?
  quotePrefix       String   @default("QT")
  validityDays      Int      @default(15)
  defaultWarranty   String?
  signatoryName     String?
  signatoryTitle    String?
  logoId            String?
  signatureId       String?
  updatedAt         DateTime @updatedAt
}

/// Reusable scope-of-work text, payment milestone sets and T&C clause sets.
model Template {
  id         String       @id @default(cuid())
  kind       TemplateKind
  name       String
  body       String?
  milestones Json?
  isDefault  Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([kind])
}

/// One row per calendar year; incremented atomically to hand out quote numbers.
model QuoteCounter {
  year Int @id
  last Int @default(0)
}

model Quote {
  id                     String       @id @default(cuid())
  quoteNumber            String
  version                Int          @default(1)
  isLatest               Boolean      @default(true)
  status                 QuoteStatus  @default(DRAFT)
  customerId             String
  createdById            String
  issueDate              DateTime     @db.Date
  validUntil             DateTime     @db.Date
  siteAddress            String?
  discountType           DiscountType @default(AMOUNT)
  discountValue          Decimal      @default(0) @db.Decimal(12, 2)
  otherCharges           Decimal      @default(0) @db.Decimal(12, 2)
  otherChargesGstPercent Decimal      @default(18) @db.Decimal(5, 2)
  scope                  String?
  paymentTerms           Json         @default("[]")
  terms                  String?
  warranty               String?

  // Totals are persisted on every save so lists and reports never recompute them.
  subtotal       Decimal @default(0) @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @db.Decimal(14, 2)
  taxableAmount  Decimal @default(0) @db.Decimal(14, 2)
  gstAmount      Decimal @default(0) @db.Decimal(14, 2)
  total          Decimal @default(0) @db.Decimal(14, 2)

  /// Unguessable token for the public PDF link included in WhatsApp / email messages.
  shareToken String    @unique
  sentAt     DateTime?
  respondedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  customer   Customer        @relation(fields: [customerId], references: [id])
  createdBy  User            @relation(fields: [createdById], references: [id])
  items      QuoteItem[]
  activities QuoteActivity[]

  @@unique([quoteNumber, version])
  @@index([status])
  @@index([createdById])
  @@index([customerId])
  @@index([isLatest, createdAt])
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String
  position    Int
  productId   String?
  name        String
  description String?
  unit        String
  quantity    Decimal  @db.Decimal(12, 3)
  rate        Decimal  @db.Decimal(12, 2)
  gstPercent  Decimal  @db.Decimal(5, 2)

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteId, position])
}

model QuoteActivity {
  id        String       @id @default(cuid())
  quoteId   String
  userId    String?
  type      ActivityType
  note      String?
  createdAt DateTime     @default(now())

  quote Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([quoteId, createdAt])
}
