 # ───────────── Copy this file to `.env` and fill in the values ─────────────

NODE_ENV=development
PORT=4000

# Public address of the app. Used to build the PDF links that go into WhatsApp / email messages.
# Local dev: the Vite dev server.  Production: your real domain, e.g. https://quotes.abcpools.in
APP_BASE_URL=http://localhost:5173

# ── Database (PostgreSQL) ──
DATABASE_URL=postgresql://poolquote:poolquote@localhost:5434/poolquote?schema=public

# ── Auth ──
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# ── Email (SMTP) ──
# Local dev with Docker: Mailpit catches mail at http://localhost:8025 (no auth needed).
# Production: use your provider's SMTP details (Google Workspace, Zoho, Brevo, SES, ...).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=,
SMTP_PASS=
MAIL_FROM="ABC Pools <quotes@abcpools.in>"

# ── PDF rendering (Puppeteer) ──
# Leave empty to use the Chrome that Puppeteer downloaded at install time.
# Set to a Chrome/Chromium binary if you install your own (common in Docker / low-memory hosts).
PUPPETEER_EXECUTABLE_PATH=

# ── First-run seed (npm run db:seed) ──
SEED_ADMIN_NAME=Owner
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe@123
# Set to "false" to skip demo customers / sample quotes and only create the admin, products and templates.
SEED_DEMO_DATA=true
